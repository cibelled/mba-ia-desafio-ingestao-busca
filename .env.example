# Provedor de IA a usar: "openai" ou "gemini"
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5-nano

# --- Google Gemini ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite

# --- PostgreSQL / pgVector ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Nome da collection dentro do pgVector
PG_COLLECTION_NAME=document_collection

# Caminho do PDF a ser ingerido
PDF_PATH=document.pdf

# Parâmetros de chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Quantidade de resultados buscados na similaridade
SEARCH_K=10
